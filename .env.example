# Spotify (Now-Playing-Karte). Refresh-Token per Spotify-OAuth-Flow erzeugen,
# Client-ID/-Secret aus dem Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Uptime Kuma (Status-Karte). Ohne Angabe werden die Defaults verwendet
# (status.vvashed.dev / Slug "vvashed") - nur nötig, falls sich das ändert.
# STATUS_PAGE_BASE_URL=https://status.vvashed.dev
# STATUS_PAGE_SLUG=vvashed
